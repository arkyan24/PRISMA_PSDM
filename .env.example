# Google Custom Search API
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CX_ID=your_custom_search_engine_id_here

# Server
PORT=3000

# IndoBERT Sentiment Analysis Service
SENTIMENT_API_URL=http://127.0.0.1:8000
SENTIMENT_TIMEOUT_MS=6000
SENTIMENT_MODEL_ID=mdhugol/indonesia-bert-sentiment-classification

# Catatan: Jika SENTIMENT_API_URL offline, Prisma otomatis fallback ke Lexicon NLP engine.